  "hypotheses": [
    {
      "id": "H1",
      "mechanism": "Elevated correctable-error volume and frequency reflect accumulating degraded cells/rows before a hard failure.",
      "basis": "Prior DRAM failure studies and field telemetry: CE rate often escalates before uncorrectable faults.",
      "fields": [
        "all_ce_count_1h",
        "all_ce_count_6h",
        "log_happen_frequency_6h",
        "raw_24h_events",
        "raw_7d_events"
      ],
      "expected_direction": "higher_in_failing",
      "falsified_if": "Failing devices do not show elevated CE event counts or log occurrence frequency compared with healthy devices after accounting for exposure time."
    },
    {
      "id": "H2",
      "mechanism": "Persistent weak cells/rows generate repeated multi-event CE bursts in a short window.",
      "basis": "Field failure analysis: multi-event bursts indicate repeated failures at the same weak structure.",
      "fields": [
        "burst_count_3_1h",
        "burst_count_4_1h",
        "burst_count_5_1h",
        "burst_count_6_1h",
        "burst_count_7_1h",
        "burst_count_8_1h",
        "error_burst_count_6h"
      ],
      "expected_direction": "higher_in_failing",
      "falsified_if": "Failing devices do not have higher counts of multi-event bursts than healthy devices with comparable total CE volume."
    },
    {
      "id": "H3",
      "mechanism": "CE storms represent intermittent massive bursts from unstable wordlines or row activation, preceding field failure.",
      "basis": "Operational memory reliability experience: storm-like CE bursts often indicate weak row or wordline structures.",
      "fields": [
        "ce_storm_count_15m",
        "ce_storm_count_1h",
