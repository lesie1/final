  "failure": {
    "mode": "indicator",
    "column": "failure",
    "positive_values": [
      "1"
    ],
    "definition": "Binary indicator: 1 means the last operational day before a known failure; 0 means no failure recorded on that date (not proof of permanent health)."
  },
  "followup": {
    "mode": "last_observation",
    "basis": "Conservative follow-up ends at each device's last recorded observation. Device disappearance is not treated as failure or health."
  },
  "description": "Backblaze Drive Stats daily observations for 2024. All SMART normalized and raw columns are treated as numeric_unknown due to lack of per-attribute semantic documentation; units unknown. One glob covers all quarterly folders; missing columns in any quarter will be NaN. Device ID from serial_number, date used as UTC day index."
}
